---
interface Props {
    href: string;
    title: string;
    description?: string;
}

const { href, title, description } = Astro.props;
---

<a class="project-card" href={href} target="_blank" rel="noreferrer">
    <div class="project-card__top">
        <span class="project-card__label">Project</span>
        <span class="project-card__icon" aria-hidden="true">↗</span>
    </div>
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__description">{description}</p>
</a>