	</head>
	<body>
		<div class="bg-orb bg-orb--cyan" aria-hidden="true"></div>
		<div class="bg-orb bg-orb--rose" aria-hidden="true"></div>
		<div class="bg-orb bg-orb--mint" aria-hidden="true"></div>
		<slot />
	</body>
</html>
